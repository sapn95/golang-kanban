# Copy to .env in this directory. Compose reads it on its own.

# The image tag to run. A version rather than latest, so an upgrade is something
# you did on purpose.
KANBAN_TAG=2.2.1

# The port on the host.
KANBAN_PORT=17808

# The postgres profile needs this. Left empty, the database container refuses to
# initialise. The sqlite and demo profiles ignore it.
POSTGRES_PASSWORD=

# Snapshots. 0 turns the schedule off; BACKUP_KEEP=0 keeps every one.
BACKUP_INTERVAL=24h
BACKUP_KEEP=7
